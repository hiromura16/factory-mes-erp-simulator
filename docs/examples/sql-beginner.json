{
  "name": "設備実績 / 3ライン / 温度スパイクあり",
  "description": "【想定】3ライン×10設備の生産実績をSQLに投入し、CDCで取り込む。\n【異常】50〜59件目で温度が250℃に跳ねる。",
  "run_key": "equip-results-001",
  "seed": 42,
  "rows": 3,
  "target_rate": 0,
  "batch_size": 100,
  "parameters": {
    "equipment_count": 10,
    "lines": [
      "L1",
      "L2",
      "L3"
    ],
    "start_time": "2026-12-01T08:00:00+09:00"
  },
  "fields": [
    {
      "name": "id",
      "data_type": "string",
      "generator": "record_id",
      "primary_key": true,
      "length": 64
    },
    {
      "name": "seq_no",
      "data_type": "integer",
      "generator": "sequence"
    },
    {
      "name": "equipment_no",
      "data_type": "integer",
      "generator": "integer",
      "minimum": 1,
      "maximum": "$equipment_count"
    },
    {
      "name": "equipment_code",
      "data_type": "string",
      "generator": "template",
      "template": "EQ-{equipment_no:03d}",
      "length": 16
    },
    {
      "name": "line",
      "data_type": "string",
      "generator": "choice",
      "choices": "$lines",
      "length": 8
    },
    {
      "name": "status",
      "data_type": "string",
      "generator": "choice",
      "choices": [
        "RUN",
        "IDLE",
        "STOP"
      ],
      "weights": [
        90,
        8,
        2
      ],
      "length": 8
    },
    {
      "name": "temperature",
      "data_type": "number",
      "generator": "normal",
      "mean": 65,
      "stddev": 2.5,
      "scale": 1
    },
    {
      "name": "output_qty",
      "data_type": "integer",
      "generator": "integer",
      "minimum": 80,
      "maximum": 120
    },
    {
      "name": "reject_qty",
      "data_type": "integer",
      "generator": "integer",
      "minimum": 0,
      "maximum": 5
    },
    {
      "name": "good_qty",
      "data_type": "integer",
      "generator": "difference",
      "sources": [
        "output_qty",
        "reject_qty"
      ]
    },
    {
      "name": "yield_ratio",
      "data_type": "number",
      "generator": "ratio",
      "sources": [
        "good_qty",
        "output_qty"
      ],
      "scale": 4
    },
    {
      "name": "unit_price",
      "data_type": "decimal",
      "generator": "constant",
      "value": "125.50",
      "precision": 12,
      "scale": 2
    },
    {
      "name": "stop_reason",
      "data_type": "string",
      "generator": "constant",
      "value": null,
      "length": 32,
      "condition": {
        "field": "status",
        "operator": "eq",
        "value": "STOP",
        "then_value": "MAINTENANCE"
      }
    },
    {
      "name": "event_time",
      "data_type": "datetime",
      "generator": "timestamp",
      "start": "$start_time",
      "step": 60,
      "group_size": "$equipment_count"
    }
  ],
  "anomalies": [
    {
      "name": "温度スパイク",
      "field": "temperature",
      "operation": "set",
      "value": 250,
      "from_row": 50,
      "to_row": 59
    }
  ],
  "sql": {
    "schema_name": "",
    "table": "equipment_results",
    "operation": "insert"
  }
}
