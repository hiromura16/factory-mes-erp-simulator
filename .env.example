# 実際の認証情報は公開せず、配備先の .env で管理します。
BIND_IP=127.0.0.1
APP_PORT=3560
TZ=Asia/Tokyo
APP_MEMORY=512m
APP_CPUS=1.0
# ホスト側で実行中に確保する空きメモリ（GiB）。APP_MEMORYはコンテナの上限です。
MIN_AVAILABLE_GIB=1
SQL_HOST=
SQL_PORT=3510
SQL_PASSWORD_FILE=/dev/null
SQL_DATABASE=FactorySourceLab
SQL_USER=factory_source_writer
ORACLE_CLIENT_MODE=thin

# イメージのビルド専用。必要なときだけ、私用の設定で対応する大小文字の行を有効にする。
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1,::1
# http_proxy=
# https_proxy=
# no_proxy=localhost,127.0.0.1,::1
